eval "$(uv generate-shell-completion zsh)"

# ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=12"


# yazi
function y() {
        local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
        yazi "$@" --cwd-file="$tmp"
        IFS= read -r -d '' cwd < "$tmp"
        [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
        rm -f -- "$tmp"
}

export LIBVIRT_DEFAULT_URI=qemu:///system

export GOPATH="$HOME/.go"
export PATH="$PATH:$GOPATH/bin"
export GOPROXY=https://mirrors.aliyun.com/golang/,direct

fpath+=~/.zfunc; autoload -Uz compinit; compinit

eval $(thefuck --alias)


[ "$TERM" = "xterm-kitty" ] && alias ssh="kitty +kitten ssh"

# mise 配置 - 独立禁用 Python 和 Node
[[ -f "$HOME/.config/mise/mise.zsh" ]] && source "$HOME/.config/mise/mise.zsh"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/hyperbola/.conda/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/hyperbola/.conda/etc/profile.d/conda.sh" ]; then
        . "/home/hyperbola/.conda/etc/profile.d/conda.sh"
    else
        export PATH="/home/hyperbola/.conda/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<


# >>> mamba initialize >>>
# !! Contents within this block are managed by 'mamba shell init' !!
export MAMBA_EXE='/home/hyperbola/.conda/bin/mamba';
export MAMBA_ROOT_PREFIX='/home/hyperbola/.conda';
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"  # Fallback on help from mamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<


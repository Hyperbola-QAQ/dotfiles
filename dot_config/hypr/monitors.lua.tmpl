-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all


{{- if eq .chezmoi.hostname "hyqaq-pc" }}

local omarchy_gdk_scale = 2
local omarchy_monitor_scale = 2

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
-- hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- 主屏幕：2560x1440 @ 100Hz（工作区区块 1-10，由 Omarchy 4.5 的每屏区块自动分配）
-- 广色域关闭说明：
-- KTC H27T13 官网规格为「色深 8bit / 16.7M 色」，面板本身不支持 10bit。
-- 其 EDID 为过 HDR10 认证声明了 BT2020RGB + SMPTE ST2084，Hyprland 据此开启 WCG 渲染，
-- 但实际输出恒为 XRGB8888（8bit），两者不一致会触发
-- "wide color gamut is enabled but the display is not in 10-bit mode" 警告。
-- 另外 1440p@100 的像素时钟已顶满 EDID 声明的 400MHz TMDS 字符率上限，
-- 10bit 需要 500MHz，物理上跑不了。故此处强制关闭广色域检测。
hl.monitor({
    output = "HDMI-A-1",        -- 请替换为你的主屏幕实际输出名
    mode = "2560x1440@100", -- 设置分辨率和刷新率
    position = "0x0",       -- 位于虚拟布局的起点
    scale = 1.67,
    supports_wide_color = -1, -- -1=强制不支持广色域（0=按EDID自动，1=强制支持）
})

-- 副屏幕：1920x1080 @ 75Hz（工作区区块 11-20）
hl.monitor({
    output = "HDMI-A-2",        -- 请替换为你的副屏幕实际输出名
    mode = "1920x1080@75",  -- 设置分辨率和刷新率
    position = "auto-right",    -- 放置在主屏幕右侧
    scale = 1,
})

-- 不再手工绑定「工作区 → 显示器」。
-- Omarchy 4.5 起每块显示器自带 10 个工作区的区块（主屏 1-10、副屏 11-20），
-- 由 default/hypr/monitor-workspaces.lua 按显示器 make/model/serial 分配并记住，
-- 状态在 ~/.local/state/omarchy/monitor-workspaces。手写 workspace_rule 会和它抢，
-- 反而让 Super+数字 在副屏上跳回主屏。

{{- end }}

{{- if eq .chezmoi.hostname "hyqaq-laptop" }}

local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

{{- end }}



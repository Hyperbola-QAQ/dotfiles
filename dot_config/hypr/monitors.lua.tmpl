{{- if eq .chezmoi.hostname "hyqaq-pc" }}

-- ============================================
-- 采集卡热插拔后修复 X 侧的 primary output
-- ============================================
-- 主屏挂在 A/Vaux GC553G2 采集盒后面，采集盒每次重新协商 HDMI 都会触发热插拔，
-- xwayland 重建输出后 X 的 primary output 会悬空，Wine/Proton 因此判定不出主屏，
-- 游戏可能把 1080p 的副屏当成运行屏幕。脚本内含等待与重试，见 apps/fix-x-primary.sh。
local fix_x_primary = "bash " .. os.getenv("HOME") .. "/.config/hypr/apps/fix-x-primary.sh"

hl.on("monitor.added", function() hl.dispatch(hl.dsp.exec_cmd(fix_x_primary)) end)
hl.on("monitor.removed", function() hl.dispatch(hl.dsp.exec_cmd(fix_x_primary)) end)
hl.on("monitor.layout_changed", function() hl.dispatch(hl.dsp.exec_cmd(fix_x_primary)) end)

-- 兜底：热插拔事件没赶上时，任何新窗口打开（典型是游戏启动）都再确认一次。
-- 脚本有快路径，primary 正常时直接退出，不会带来可感知开销。
hl.on("window.open", function()
  hl.dispatch(hl.dsp.exec_cmd(fix_x_primary))
end)
{{- end }}
